<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi Chat"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>


        <Border Background="#0F172A">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="💬 ROOMS"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="15"/>

                    <Button x:Name="btnCreateRoom"
                            Content="+ Create Room"
                            Height="40"
                            Margin="10"
                            Background="#22C55E"
                            Foreground="White"
                            Click="btnCreateRoom_Click"/>

                </StackPanel>

                <ListBox x:Name="listRooms"
                         MouseDoubleClick="listRooms_MouseDoubleClick"
                         Margin="10"
                         Background="#1E293B"
                         Foreground="White"
                         BorderThickness="0"/>

            </DockPanel>

        </Border>


        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                
            </Grid.RowDefinitions>

            <Border Background="#1E293B">

                <Grid>

                    <TextBlock x:Name="txtCurrentRoom"
                               Text="# General"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="20"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <ListBox x:Name="listMessages"
                     Grid.Row="1"
                     Margin="15"
                     Background="#111827"
                     Foreground="White"
                     BorderThickness="0">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Копіювати" Click="CopyMessage_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Grid Grid.Row="2" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnEmoji"
                        Grid.Column="0"
                        Content="😊"
                        Width="45"
                        Height="45"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="20"
                        Click="btnEmoji_Click"/>

                <TextBox x:Name="txtMessage"
                         Grid.Column="1"
                         Height="45"
                         VerticalAlignment="Center"
                         Background="#374151"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         KeyDown="txtMessage_KeyDown"
                         TextChanged="txtMessage_TextChanged"/>

                <Button x:Name="btnSend"
                        Grid.Column="2"
                        Content="Send"
                        Margin="10,0,0,0"
                        Background="#3B82F6"
                        Foreground="White"
                        Click="btnSend_Click"/>

                <Button x:Name="btnDelete"
                        Grid.Column="3"
                        Content="Delete"
                        Margin="10,0,0,0"
                        Background="#EF4444"
                        Foreground="White"
                        Click="btnDelete_Click"/>
            </Grid>


            <TextBlock x:Name="txtTyping"
                       Grid.Row="3"
                       Foreground="Gray"
                       FontStyle="Italic"
                       Margin="15,5,15,5"
                       FontSize="12"/>

        </Grid>


        <Border Grid.Column="2"
                Background="#0F172A">

            <StackPanel>

                <TextBlock Text="ONLINE USERS"
           Foreground="White"
           FontSize="16"
           FontWeight="Bold"
           Margin="10,15,10,5"/>

                <ListBox x:Name="listUsers"
         Margin="10"
         Height="150"
         Background="#1E293B"
         Foreground="White"
         BorderThickness="0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>