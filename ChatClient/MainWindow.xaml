<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Підказка -->
        <TextBlock Grid.Row="0" Text="/msg ім'я отримувача текст → приватне повідомлення | Вибери повідомлення → Delete" 
                   FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

        <!-- Список повідомлень -->
        <ListBox x:Name="listMessages" Grid.Row="1" SelectionMode="Single"/>

        <!-- Панель вводу -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtMessage" KeyDown="txtMessage_KeyDown" Foreground="Gray"/>
            <Button x:Name="btnSend" Grid.Column="1" Content="Send" Margin="5,0,0,0" Click="btnSend_Click"/>
            <Button x:Name="btnDelete" Grid.Column="2" Content="Delete" Margin="5,0,0,0" Click="btnDelete_Click" Background="#FF6B6B" Foreground="White"/>
        </Grid>
    </Grid>
</Window>