<Window x:Class="ChatClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi Chat System"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111827">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.3*"/>
            <ColumnDefinition Width="1.7*"/>
        </Grid.ColumnDefinitions>

        
        <Border Background="#0F172A">

            <Grid Margin="40">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="💬"
                               FontSize="80"
                               Foreground="#60A5FA"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="MULTI CHAT SYSTEM"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,10"/>

                    <TextBlock Text="TCP Client / Server Application"
                               FontSize="16"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">

                    <Border Background="#1E293B"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="🧑‍🤝‍🧑 Multi User Chat"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Communicate with multiple users simultaneously"
                                       Foreground="#CBD5E1"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#1E293B"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="🏠 Rooms"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Create and join chat rooms"
                                       Foreground="#CBD5E1"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#1E293B"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="📩 Private Messages"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Send direct messages to users"
                                       Foreground="#CBD5E1"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#1E293B"
                            CornerRadius="12"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="🕒 Message History"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Stored and loaded automatically"
                                       Foreground="#CBD5E1"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                </StackPanel>

                <StackPanel Grid.Row="2">

                    <TextBlock Text="Server Status: Offline"
                               Foreground="#F87171"
                               FontSize="14"/>

                    <TextBlock Text="Version 1.0"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        
        <Grid Grid.Column="1">

            <Border Width="420"
                    Height="500"
                    Background="#1F2937"
                    CornerRadius="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel Margin="40">

                    <TextBlock Text="Welcome Back"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Sign in to continue"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,35"/>
                    

                    <TextBlock Text="Username"
                               Foreground="White"/>
                    

                    <TextBox x:Name="txtLogin"
                             Height="45"
                             FontSize="14"
                             Margin="0,8,0,20"
                             Background="#374151"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10"/>

                    <TextBlock Text="Password"
                               Foreground="White"/>

                    <PasswordBox x:Name="txtPassword"
                                 Height="45"
                                 FontSize="14"
                                 Margin="0,8,0,30"
                                 Background="#374151"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="10"/>

                    <Button x:Name="btnLogin"
                            Content="Login"
                            Height="48"
                            FontWeight="Bold"
                            FontSize="15"
                            Click="btnLogin_Click"
                            Background="#3B82F6"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button x:Name="btnRegister"
                            Content="Register"
                            Height="48"
                            FontWeight="Bold"
                            FontSize="15"
                            Margin="0,15,0,0"
                            Background="#22C55E"
                            Foreground="White"
                            BorderThickness="0" Click="btnRegister_Click"/>

                    <TextBlock x:Name="txtError"
                               Foreground="#F87171"
                               FontSize="13"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Window>